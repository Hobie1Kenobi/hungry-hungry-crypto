# Hungry Hungry Crypto — Phase 4 config template
# Copy to .env locally. NEVER commit .env or seeds.

# XRPL Testnet (Altnet). Do not point the client at Mainnet.
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
XRPL_FAUCET_URL=https://faucet.altnet.rippletest.net/
XRPL_EXPLORER_URL=https://testnet.xrpl.org

# Network guard. Allowed: testnet. Mainnet requires Orchestrator Launch Gate (see docs/LAUNCH.md).
XRPL_NETWORK=testnet

# Classic r-addresses (public). Create a durable Testnet issuer + CRUMB treasury with:
#   pnpm --filter @hhc/xrpl create-issuer
# That command stores XRPL_ISSUER_SEED and XRPL_TREASURY_SEED in this file only.
# CRUMB on Testnet has no value. This is not money.
XRPL_ISSUER_ADDRESS=
XRPL_ISSUER_SEED=
XRPL_TREASURY_ADDRESS=
XRPL_TREASURY_SEED=

# Optional 3-character ISO code. Default product name is CRUMB (hex-encoded on ledger).
# XRPL_CRUMB_CURRENCY=CRUMB

# Colyseus / match server. Web client uses VITE_GAME_SERVER_URL.
GAME_SERVER_URL=ws://localhost:2567
GAME_SERVER_PORT=2567
VITE_GAME_SERVER_URL=ws://localhost:2567
